# ─── Discord ────────────────────────────────────────────────────────────────
# Токен бота: https://discord.com/developers/applications → Bot → Reset Token
DISCORD_TOKEN=

# ID приложения (General Information → Application ID). Не обязателен:
# если пусто, бот возьмёт его из токена при запуске.
DISCORD_CLIENT_ID=

# ID сервера. Если указан — слэш-команды появляются мгновенно именно там.
# Если пусто — команды регистрируются глобально (до 1 часа на обновление).
GUILD_ID=

# Роли, которым разрешено управлять чек-листами (/criteria ...).
# Можно несколько через запятую — роли с разных серверов тоже (ID уникальны).
# Если пусто — только у администраторов сервера.
REVIEWER_ROLE_ID=

# Роли, которым можно запускать проверку (/review).
# Пусто — проверку может запускать любой участник. Пример:
# REVIEW_ROLE_IDS=1466491886452736133,1448276875343564861,1425947263209050304
REVIEW_ROLE_IDS=

# ─── LLM (проверка «глазами ИИ») ────────────────────────────────────────────
# Любой OpenAI-совместимый API. Примеры:
#   DeepSeek : https://api.deepseek.com/v1        модель deepseek-chat
#   OpenAI   : https://api.openai.com/v1          модель gpt-4o-mini
#   OpenRouter: https://openrouter.ai/api/v1      модель openai/gpt-4o-mini
#   Ollama   : http://localhost:11434/v1          модель qwen2.5:14b
# Если LLM_API_KEY пуст — бот работает в режиме только автопроверок.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=3000
LLM_TIMEOUT_MS=120000

# ─── Прочее ─────────────────────────────────────────────────────────────────
# Сколько символов документа максимум отправлять в модель
MAX_DOC_CHARS=60000

# Чек-лист по умолчанию (имя файла без .md). Если пусто — берётся первый из data/criteria
DEFAULT_CRITERIA=ova-dossier

# Регистрировать слэш-команды при каждом старте (true/false)
DEPLOY_COMMANDS=true
